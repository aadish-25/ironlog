<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#0f0f0f</item>
        <item name="colorPrimaryDark">#0f0f0f</item>
        <item name="colorAccent">#e8460a</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">#0f0f0f</item>
        <item name="android:statusBarColor">#0f0f0f</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0f0f0f</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">#0f0f0f</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>